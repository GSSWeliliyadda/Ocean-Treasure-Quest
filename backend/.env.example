# Safe local development configuration template for Ocean Treasure Quest backend.
# Copy this file to backend/.env (gitignored) OR export these as OS / IDE environment variables.
# NOTE: Do NOT wrap values in quotes in .env or application-local.properties.

DB_URL=jdbc:mysql://localhost:3306/ocean_treasure_quest?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

